# Public URL of the app, without trailing slash.
APP_URL=http://localhost:3000
# 32+ random characters. Used to derive HMAC keys (IP hashing, upload tickets).
APP_SECRET=

# Supabase project settings > API keys. The secret key never reaches the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Mercado Pago. Use test credentials outside production.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Bearer token Vercel Cron sends to /api/cron/maintenance.
CRON_SECRET=

# Optional transactional email.
RESEND_API_KEY=
EMAIL_FROM=

# Shown on legal pages and footer.
CONTACT_EMAIL=

# Set to true after configuring the Google provider in Supabase Auth.
AUTH_GOOGLE_ENABLED=false
